<UserControl x:Class="PerformanceTracker.Desktop.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PerformanceTracker.Desktop">
  <UserControl.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#111E2C" />
      <Setter Property="BorderBrush" Value="#24384C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#E6EEF5" />
    </Style>

    <!-- A full-width clickable row with a hover highlight. -->
    <Style x:Key="RowButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#E6EEF5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="10" Padding="8,7">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#1B3045" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text-only link button for "See all" actions. -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#5CC8D8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Live tiles -->
    <DockPanel Margin="2,4,2,8">
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="#8EA3B8" x:Name="WindowCaption" />
      <TextBlock Style="{StaticResource CardTitleStyle}" Text="Right now" />
    </DockPanel>
    <ItemsControl x:Name="Tiles" Grid.Row="1" Margin="0,0,-10,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Visibility" Value="{Binding Visibility}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:DashboardTileViewModel}">
          <Border Margin="0,0,10,0" Padding="14,12,14,10" Style="{StaticResource CardStyle}" ToolTip="{Binding ToolTip}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding Accent}" />
                <TextBlock FontWeight="SemiBold" Foreground="#8EA3B8" Text="{Binding Title}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" FontSize="26" FontWeight="SemiBold" Foreground="White" Text="{Binding Value}" />
              <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="#A9BACB" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
              <local:Sparkline Height="64" Margin="0,10,0,0" Values="{Binding History}" Maximum="{Binding Maximum}" Stroke="{Binding Accent}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Bottom cards -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Margin="0,0,10,0" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}" Content="See all apps" Click="ShowAppsClick" />
            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Using the most memory" />
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TopApps">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:AppRowViewModel}">
                  <Button Style="{StaticResource RowButtonStyle}" Click="AppRowClick" ToolTip="{Binding Explanation}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Image Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Source="{Binding Icon}" />
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                                  Background="{Binding StatusBackground}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" Text="{Binding StatusText}" />
                          </Border>
                          <TextBlock TextTrimming="CharacterEllipsis">
                            <Run FontWeight="SemiBold" Text="{Binding DisplayName, Mode=OneWay}" />
                            <Run Foreground="#8EA3B8" Text="{Binding TopActivity, Mode=OneWay}" />
                          </TextBlock>
                        </DockPanel>
                        <ProgressBar Height="5" Margin="0,6,0,0" Maximum="1" Value="{Binding MemoryFraction, Mode=OneWay}"
                                     Foreground="#42CED9" Background="#22364A" BorderThickness="0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" MinWidth="70" VerticalAlignment="Center" TextAlignment="Right"
                                 FontWeight="SemiBold" Text="{Binding MemoryText}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="TopAppsEmpty" Grid.Row="1" Foreground="#8EA3B8" Text="Reading running apps..." />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}" Content="Full history" Click="ShowTimelineClick" />
            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Recent slowdowns" />
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RecentEvents">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DashboardEventItem}">
                  <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Margin="2,5,12,0" VerticalAlignment="Top" Fill="{Binding Brush}" />
                    <StackPanel Grid.Column="1">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12" Foreground="#8EA3B8" Text="{Binding When}" />
                        <TextBlock FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Margin="0,2,0,0" Foreground="#8EA3B8" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Cause}" ToolTip="{Binding Cause}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="EventsEmpty" Grid.Row="1">
            <TextBlock Foreground="#C3D0DC" TextWrapping="Wrap" Text="No slowdowns in the last 24 hours." />
            <TextBlock Margin="0,4,0,0" Foreground="#8EA3B8" TextWrapping="Wrap"
                       Text="If your PC gets bogged down, for example memory nearly full or the processor maxed out, you'll see what happened and why here." />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock x:Name="FooterText" Grid.Row="3" Margin="4,10,0,0" FontSize="12" Foreground="#6B7F94" />
  </Grid>
</UserControl>
