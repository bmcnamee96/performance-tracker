<UserControl x:Class="PerformanceTracker.Desktop.AlertSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="#111E2C" BorderBrush="#24384C" BorderThickness="1" Padding="14" Margin="0,0,0,12">
    <StackPanel>
      <TextBlock Text="Alerts" FontSize="18" Margin="0,0,0,8" />
      <CheckBox x:Name="MemoryAlert" Foreground="#E6EEF5" Content="Tell me when memory stays high for one minute" />
      <StackPanel Orientation="Horizontal" Margin="0,8">
        <Label Content="Memory alert threshold (%)" Foreground="#E6EEF5" Target="{Binding ElementName=Threshold}" />
        <TextBox x:Name="Threshold" Width="56" MaxLength="2" VerticalContentAlignment="Center" />
      </StackPanel>
      <CheckBox x:Name="GrowthAlert" Foreground="#E6EEF5" Content="Tell me when an app starts using much more memory" />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Save alert settings" Click="SaveClick" Margin="0,0,8,0" />
        <Button Content="Send a test alert" Click="TestClick" />
      </StackPanel>
      <TextBlock x:Name="Status" Foreground="#8EA3B8" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
