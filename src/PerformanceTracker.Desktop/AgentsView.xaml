<UserControl x:Class="PerformanceTracker.Desktop.AgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PerformanceTracker.Desktop">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="StatTile" TargetType="Border">
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Background" Value="#111E2C" />
      <Setter Property="BorderBrush" Value="#24384C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#8EA3B8" />
    </Style>

    <!-- One agent: a clickable card that opens its helpers, which hang off a guide line underneath. -->
    <Style x:Key="AgentTreeItem" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <ToggleButton x:Name="CardToggle" Focusable="False" Margin="0,0,0,8"
                            AutomationProperties.Name="Show or hide helpers"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter />
                  </ControlTemplate>
                </ToggleButton.Template>
                <Border x:Name="Card" Padding="0,0,14,0" Background="#111E2C" BorderBrush="#24384C" BorderThickness="1" CornerRadius="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Accent" Width="4" Margin="8,10,0,10" CornerRadius="2" Background="#53B1FD" />
                    <TextBlock x:Name="Chevron" Grid.Column="1" Width="26" Margin="6,0,0,0" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="14" Foreground="#5CC8D8" Text="&#x25B8;" />
                    <ContentPresenter Grid.Column="2" Margin="6,10,0,10" ContentSource="Header" />
                  </Grid>
                </Border>
              </ToggleButton>

              <Grid x:Name="Helpers">
                <Rectangle Width="2" Margin="21,0,0,8" HorizontalAlignment="Left" Fill="#24384C" RadiusX="1" RadiusY="1" />
                <ItemsPresenter Margin="36,0,0,0" />
              </Grid>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;" />
              </Trigger>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="Helpers" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Helpers" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CardToggle" Property="IsHitTestVisible" Value="False" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition SourceName="CardToggle" Property="IsMouseOver" Value="True" />
                  <Condition Property="HasItems" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Card" Property="Background" Value="#162A3D" />
                <Setter TargetName="Card" Property="BorderBrush" Value="#2E4A63" />
                <Setter TargetName="CardToggle" Property="Cursor" Value="Hand" />
              </MultiTrigger>
              <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="Accent" Property="Background" Value="#90F76E" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Margin="0,0,0,14" Padding="18,16" Background="#0F2438" BorderBrush="#24384C" BorderThickness="1" CornerRadius="14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Agents in T3 Code" />
            <TextBlock Margin="0,4,0,0" Foreground="#8EA3B8" TextWrapping="Wrap"
                       Text="Each thread with the helpers it started underneath. Click a card to show or hide its helpers. Updates every 3 seconds while this tab is open." />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="Expand all" Click="ExpandAllClick" />
            <Button Margin="8,0,0,0" Content="Collapse all" Click="CollapseAllClick" />
            <Button Margin="8,0,0,0" Content="Refresh" Click="RefreshClick" />
          </StackPanel>
        </Grid>

        <WrapPanel Margin="0,14,0,0">
          <Border Style="{StaticResource StatTile}">
            <StackPanel>
              <TextBlock x:Name="ThreadCount" Style="{StaticResource StatNumber}" Text="–" />
              <TextBlock Style="{StaticResource StatLabel}" Text="Threads" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatTile}">
            <StackPanel>
              <TextBlock x:Name="WorkingCount" Style="{StaticResource StatNumber}" Foreground="#90F76E" Text="–" />
              <TextBlock Style="{StaticResource StatLabel}" Text="Agents working" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatTile}">
            <StackPanel>
              <TextBlock x:Name="WaitingCount" Style="{StaticResource StatNumber}" Foreground="#53B1FD" Text="–" />
              <TextBlock Style="{StaticResource StatLabel}" Text="Waiting on helpers" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatTile}" MinWidth="200">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Margin="0,0,0,6" Text="Working by model" />
              <TextBlock x:Name="NoModels" FontSize="12" Foreground="#8EA3B8" Text="None" Visibility="Collapsed" />
              <ItemsControl x:Name="ModelChips">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,6,2" Padding="8,2" CornerRadius="9" Background="#12303F" BorderBrush="#1F658E" BorderThickness="1">
                      <TextBlock FontSize="12" Foreground="#E6EEF5">
                        <Run FontWeight="SemiBold" Text="{Binding Count, Mode=OneWay}" />
                        <Run Foreground="#8EA3B8" Text="×" />
                        <Run Foreground="#B8D8ED" Text="{Binding Model, Mode=OneWay}" />
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </WrapPanel>

        <TextBlock x:Name="Status" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="#FDB022" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <Border x:Name="EmptyMessage" Grid.Row="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
            Background="#111E2C" BorderBrush="#24384C" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
      <StackPanel>
        <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#E6EEF5" Text="Nothing is running in T3 Code right now" />
        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#8EA3B8" Text="Start a thread and it will show up here within a few seconds." />
      </StackPanel>
    </Border>

    <TreeView x:Name="Tree" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,0,10,0"
              ItemContainerStyle="{StaticResource AgentTreeItem}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              VirtualizingPanel.ScrollUnit="Pixel">
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:AgentRowViewModel}" ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource AgentTreeItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" MaxWidth="560" FontSize="14" FontWeight="SemiBold" Foreground="#E6EEF5"
                           Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <Border DockPanel.Dock="Left" Margin="8,0,0,0" Padding="7,1" CornerRadius="8" Background="#1A2E42" VerticalAlignment="Center"
                        ToolTip="{Binding ModelToolTip}">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#5CC8D8" Text="{Binding ModelText}" />
                </Border>
              </DockPanel>
              <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#C3D0DC" TextTrimming="CharacterEllipsis" Text="{Binding HelpersText}"
                         Visibility="{Binding HasHelpers, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#8EA3B8" TextTrimming="CharacterEllipsis" Text="{Binding DetailText}" />
            </StackPanel>

            <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="11">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="#53B1FD" />
                <TextBlock x:Name="StateLabel" FontSize="11" FontWeight="SemiBold" Foreground="#53B1FD" Text="{Binding StateText}" />
              </StackPanel>
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#102A45" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                      <Setter Property="Background" Value="#14361F" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
          </Grid>
          <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
              <Setter TargetName="Dot" Property="Fill" Value="#90F76E" />
              <Setter TargetName="StateLabel" Property="Foreground" Value="#90F76E" />
            </DataTrigger>
          </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
