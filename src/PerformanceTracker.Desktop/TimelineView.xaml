<UserControl x:Class="PerformanceTracker.Desktop.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PerformanceTracker.Desktop">
  <Grid x:Name="ContentRoot" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Overview: totals and a bar chart of when slowdowns happened -->
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="RangeToday" Style="{StaticResource ChipRadio}" Content="Today" IsChecked="True" Checked="RangeChanged" />
            <RadioButton x:Name="RangeWeek" Style="{StaticResource ChipRadio}" Content="7 days" Checked="RangeChanged" />
            <RadioButton x:Name="RangeMonth" Style="{StaticResource ChipRadio}" Content="30 days" Checked="RangeChanged" />
          </StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Slowdowns" VerticalAlignment="Center" />
        </DockPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Foreground="#8EA3B8" FontWeight="SemiBold" Text="Slowdowns" />
            <TextBlock x:Name="CountText" Margin="0,2,0,0" FontSize="24" FontWeight="SemiBold" Foreground="White" Text="--" />
          </StackPanel>
          <StackPanel>
            <TextBlock Foreground="#8EA3B8" FontWeight="SemiBold" Text="Time slowed down" />
            <TextBlock x:Name="TotalText" Margin="0,2,0,0" FontSize="24" FontWeight="SemiBold" Foreground="White" Text="--" />
          </StackPanel>
          <StackPanel>
            <TextBlock Foreground="#8EA3B8" FontWeight="SemiBold" Text="Most common" />
            <TextBlock x:Name="CommonText" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="--"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </UniformGrid>

        <!-- Bars: minutes slowed per hour (today) or per day (7 / 30 days) -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#24384C" BorderThickness="0,0,0,1" />
          <ItemsControl x:Name="Bars">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:TimelineBar}">
                <Grid Background="Transparent" ToolTip="{Binding ToolTip}">
                  <Border Margin="2,0" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Height="{Binding Height}" Background="{Binding Fill}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="BarLabels" Grid.Row="1" Margin="0,4,0,0" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:TimelineBar}">
                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#6B7F94" Text="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Border>

    <!-- Day-by-day list -->
    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Days">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:TimelineDay}">
            <StackPanel Margin="0,0,0,8">
              <DockPanel Margin="4,4,4,8">
                <TextBlock DockPanel.Dock="Right" Foreground="#8EA3B8" Text="{Binding Totals}" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding Title}" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:TimelineEntry}">
                    <Border Margin="0,0,0,8" Padding="14,11" Background="#111E2C" BorderBrush="#24384C" BorderThickness="1" CornerRadius="12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="4" Margin="0,0,14,0" CornerRadius="2" Background="{Binding Brush}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Margin="0,2,0,0" Foreground="#A9BACB" Text="{Binding Cause}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Cause}" />
                          <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Margin="0,0,6,0" Padding="7,1" CornerRadius="8" Background="#1A2E42">
                                  <TextBlock FontSize="11" Foreground="#A9BACB" Text="{Binding}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0" HorizontalAlignment="Right">
                          <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding Time}" />
                          <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" FontSize="12" Foreground="#8EA3B8" Text="{Binding Length}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel x:Name="EmptyState" Grid.Row="1" Margin="0,40,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
      <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#E6EEF5" Text="No slowdowns in this period" />
      <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="#8EA3B8"
                 Text="Your PC kept up with everything. Slowdowns show up here when it gets bogged down." />
    </StackPanel>
  </Grid>
</UserControl>
