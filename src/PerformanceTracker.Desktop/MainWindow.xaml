<Window x:Class="PerformanceTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Tracker"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="680"
        Icon="Assets/performance-tracker.ico"
        Background="#0A1420"
        Foreground="#E6EEF5"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#111E2C" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#24384C" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#8EA3B8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#162636" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#19E6FF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#90F76E" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#DCEBF7" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#12303F" />

    <LinearGradientBrush x:Key="ShellHeaderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#0B2F4D" />
      <GradientStop Offset="0.55" Color="#06233D" />
      <GradientStop Offset="1" Color="#071A2E" />
    </LinearGradientBrush>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Margin="0,0,0,12"
            Padding="18"
            Background="{StaticResource ShellHeaderBrush}"
            BorderBrush="#13496C"
            BorderThickness="1"
            CornerRadius="22">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Border Width="60"
                  Height="60"
                  CornerRadius="16"
                  Background="#0A2035"
                  BorderBrush="#1B5A82"
                  BorderThickness="1"
                  Padding="7">
            <Image Source="Assets/performance-tracker-icon.png"
                   Stretch="Uniform" />
          </Border>

          <StackPanel Margin="18,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock FontSize="27"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="Performance Tracker" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#B8D8ED"
                       Text="See what is slowing your PC down, and close what you don't need." />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                Padding="14,10"
                Background="#122B43"
                BorderBrush="#1F658E"
                BorderThickness="1"
                CornerRadius="14">
          <StackPanel>
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#B8D8ED"
                       Text="Monitoring" />
            <TextBlock x:Name="SessionHealthText"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="White"
                       Text="Starting..." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem x:Name="DashboardTab" Header="Dashboard" />

      <TabItem x:Name="AppsTab" Header="Apps &amp; Memory" />

      <TabItem x:Name="AgentsTab" Header="Agents" />

      <TabItem x:Name="StartupTab" Header="Startup Apps" />

      <TabItem x:Name="TimelineTab" Header="Event Timeline" />

      <TabItem x:Name="SettingsTab" Header="Settings" />
    </TabControl>
  </Grid>
</Window>
