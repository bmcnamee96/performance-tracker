<Window x:Class="PerformanceTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Tracker"
        Width="980"
        Height="640"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock FontSize="26" FontWeight="SemiBold" Text="Performance Tracker" />
      <TextBlock Margin="0,6,0,0"
                 Foreground="#666666"
                 Text="A local-first scaffold for lightweight Windows performance diagnostics." />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Now">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="16" Background="#F6F7F9" CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Current Status" />
              <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="14" Text="Collector starting..." />
              <TextBlock x:Name="UptimeText" Margin="0,8,0,0" Foreground="#444444" Text="Uptime: --" />
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="16" Background="#F6F7F9" CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Latest Event" />
              <TextBlock x:Name="LastEventText" Margin="0,10,0,0" TextWrapping="Wrap" Text="No events detected yet." />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Padding="16" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="System Metrics" />
              <TextBlock x:Name="CpuText" Margin="0,10,0,0" Text="CPU: --" />
              <TextBlock x:Name="MemoryText" Margin="0,6,0,0" Text="Memory: --" />
              <TextBlock x:Name="DiskText" Margin="0,6,0,0" Text="Disk: unavailable in scaffold" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Padding="16" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Process Context" />
              <TextBlock x:Name="TopProcessText" Margin="0,10,0,0" Text="Top process: --" />
              <TextBlock x:Name="ForegroundAppText" Margin="0,6,0,0" Text="Foreground app: --" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="Scaffold Notes" />
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                This first milestone focuses on repo hygiene, contracts, low-risk local storage, and a working app host.
                Deeper disk, GPU, and frame-time telemetry are intentionally deferred.
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <Border Margin="12" Padding="16" Background="#FFFFFF" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Configuration Snapshot" />
            <TextBlock x:Name="CollectorConfigText" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="RetentionConfigText" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0" Foreground="#666666" TextWrapping="Wrap">
              Create a local `appsettings.Development.json` file to tune values without changing tracked defaults.
            </TextBlock>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</Window>

