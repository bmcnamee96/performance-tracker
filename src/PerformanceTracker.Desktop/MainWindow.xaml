<Window x:Class="PerformanceTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Tracker"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Icon="Assets/performance-tracker.ico"
        Background="#EEF5FB"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FCFEFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#CAD9E6" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#4C6379" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EFF8FD" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#19E6FF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#90F76E" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#072641" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF6FF" />

    <LinearGradientBrush x:Key="ShellHeaderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#0B2F4D" />
      <GradientStop Offset="0.55" Color="#06233D" />
      <GradientStop Offset="1" Color="#071A2E" />
    </LinearGradientBrush>

    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <DataTemplate x:Key="TimelineItemTemplate">
      <Border Margin="0,0,0,10"
              Padding="12"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Width="10"
                  Height="10"
                  Margin="0,4,12,0"
                  VerticalAlignment="Top"
                  Background="{Binding SeverityBrush}"
                  CornerRadius="5" />

          <StackPanel Grid.Column="1">
            <DockPanel>
              <TextBlock FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#101828"
                         Text="{Binding Summary}" />
              <TextBlock Margin="12,0,0,0"
                         HorizontalAlignment="Right"
                         Foreground="#475467"
                         Text="{Binding SeverityText}" />
            </DockPanel>

            <TextBlock Margin="0,4,0,0"
                       Foreground="#344054"
                       TextWrapping="Wrap"
                       Text="{Binding Cause}" />

            <WrapPanel Margin="0,8,0,0">
              <TextBlock Margin="0,0,14,0"
                         Foreground="#475467"
                         Text="{Binding OccurredAtText}" />
              <TextBlock Margin="0,0,14,0"
                         Foreground="#475467"
                         Text="{Binding AppText}" />
              <TextBlock Foreground="#475467"
                         Text="{Binding MetricSummary}" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Margin="0,0,0,16"
            Padding="22"
            Background="{StaticResource ShellHeaderBrush}"
            BorderBrush="#13496C"
            BorderThickness="1"
            CornerRadius="26">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Border Width="72"
                  Height="72"
                  CornerRadius="18"
                  Background="#0A2035"
                  BorderBrush="#1B5A82"
                  BorderThickness="1"
                  Padding="8">
            <Image Source="Assets/performance-tracker-icon.png"
                   Stretch="Uniform" />
          </Border>

          <StackPanel Margin="18,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="Performance Tracker" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#B8D8ED"
                       Text="Live desktop telemetry, recent diagnoses, and local monitoring configuration." />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                Padding="16,12"
                Background="#122B43"
                BorderBrush="#1F658E"
                BorderThickness="1"
                CornerRadius="14">
          <StackPanel>
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#B8D8ED"
                       Text="Session" />
            <TextBlock x:Name="SessionHealthText"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="White"
                       Text="Starting..." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Monitoring Status" />
                <TextBlock x:Name="StatusText"
                           Margin="0,12,0,0"
                           FontSize="16"
                           Foreground="#101828"
                           Text="Collector starting..." />
                <TextBlock x:Name="UptimeText"
                           Margin="0,8,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Uptime: --" />
                <TextBlock x:Name="LastUpdatedText"
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Last sample: --" />
              </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,12,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Activity Snapshot" />
                <TextBlock x:Name="ForegroundAppText"
                           Margin="0,12,0,0"
                           Foreground="#101828"
                           Text="Foreground app: --" />
                <TextBlock x:Name="TopProcessText"
                           Margin="0,8,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Top process: --" />
                <TextBlock x:Name="TimelineHintText"
                           Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Timeline details will appear after the first sample arrives." />
              </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Session Overview" />
                <TextBlock x:Name="SessionStatsText"
                           Margin="0,12,0,0"
                           Foreground="#101828"
                           Text="Samples: --" />
                <TextBlock x:Name="MonitoringCadenceText"
                           Margin="0,8,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Cadence: --" />
                <TextBlock x:Name="EventRateText"
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Events: --" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,12,12"
                    Style="{StaticResource CardBorderStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Resource Overview" />
                <TextBlock Grid.Row="1"
                           Margin="0,6,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Current readings plus recent-window context from this desktop session." />

                <Grid Grid.Row="2" Margin="0,16,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Row="0"
                          Grid.Column="0"
                          Margin="0,0,8,8"
                          Padding="12"
                          Background="{StaticResource SurfaceBrush}"
                          CornerRadius="10">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="CPU" />
                      <TextBlock x:Name="CpuText"
                                 Margin="0,6,0,0"
                                 Foreground="#344054"
                                 TextWrapping="Wrap"
                                 Text="--" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="0"
                          Grid.Column="1"
                          Margin="8,0,0,8"
                          Padding="12"
                          Background="{StaticResource SurfaceBrush}"
                          CornerRadius="10">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="Memory" />
                      <TextBlock x:Name="MemoryText"
                                 Margin="0,6,0,0"
                                 Foreground="#344054"
                                 TextWrapping="Wrap"
                                 Text="--" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,0,8,8"
                          Padding="12"
                          Background="{StaticResource SurfaceBrush}"
                          CornerRadius="10">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="Disk" />
                      <TextBlock x:Name="DiskText"
                                 Margin="0,6,0,0"
                                 Foreground="#344054"
                                 TextWrapping="Wrap"
                                 Text="--" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,0,0,8"
                          Padding="12"
                          Background="{StaticResource SurfaceBrush}"
                          CornerRadius="10">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="Network" />
                      <TextBlock x:Name="NetworkText"
                                 Margin="0,6,0,0"
                                 Foreground="#344054"
                                 TextWrapping="Wrap"
                                 Text="--" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Padding="12"
                          Background="{StaticResource SurfaceBrush}"
                          CornerRadius="10">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="Trend Summary" />
                      <TextBlock x:Name="SampleTrendText"
                                 Margin="0,6,0,0"
                                 Foreground="#344054"
                                 TextWrapping="Wrap"
                                 Text="--" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Event Focus" />
                <TextBlock x:Name="LatestEventSeverityText"
                           Margin="0,12,0,0"
                           FontWeight="SemiBold"
                           Foreground="#7A271A"
                           Text="No event" />
                <TextBlock x:Name="LastEventText"
                           Margin="0,6,0,0"
                           FontSize="16"
                           Foreground="#101828"
                           TextWrapping="Wrap"
                           Text="No events detected yet." />
                <TextBlock x:Name="LastEventCauseText"
                           Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Likely cause details will appear here." />
                <TextBlock x:Name="LatestEventMetaText"
                           Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Timeline metadata unavailable." />
                <TextBlock x:Name="TriggerMetricsText"
                           Margin="0,10,0,0"
                           Foreground="#344054"
                           TextWrapping="Wrap"
                           Text="Trigger metrics: --" />
              </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,12,0"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Telemetry Coverage" />
                <TextBlock x:Name="CoverageText"
                           Margin="0,12,0,0"
                           Foreground="#101828"
                           TextWrapping="Wrap"
                           Text="Coverage summary pending." />
                <TextBlock x:Name="OptionalMetricsText"
                           Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Additional GPU or gaming telemetry will appear here automatically when those optional fields are present." />
              </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recent Events" />

                <ScrollViewer Grid.Row="1"
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="DashboardTimelineList"
                                ItemTemplate="{StaticResource TimelineItemTemplate}" />
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Event Timeline">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleStyle}" Text="In-Session Event History" />
              <TextBlock x:Name="TimelineSummaryText"
                         Margin="0,10,0,0"
                         Foreground="#101828"
                         TextWrapping="Wrap"
                         Text="No session events yet." />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource MutedTextStyle}"
                         Text="This view is driven by the live desktop monitor state, so it stays useful even while persistence and diagnosis work is changing elsewhere." />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="TimelineEmptyText"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedForegroundBrush}"
                       Text="No events detected in this session." />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="TimelineList"
                            ItemTemplate="{StaticResource TimelineItemTemplate}" />
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Collection and Detection" />
                <TextBlock x:Name="CollectionConfigText"
                           Margin="0,12,0,0"
                           Foreground="#101828"
                           TextWrapping="Wrap"
                           Text="Collection summary pending." />
                <TextBlock x:Name="ThresholdConfigText"
                           Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Threshold summary pending." />
                <TextBlock x:Name="WindowConfigText"
                           Margin="0,8,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Window summary pending." />
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Storage and Retention" />
                <TextBlock x:Name="RetentionConfigText"
                           Margin="0,12,0,0"
                           Foreground="#101828"
                           TextWrapping="Wrap"
                           Text="Retention summary pending." />
              </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Local Overrides" />
                <TextBlock x:Name="SettingsStatusText"
                           Margin="0,12,0,0"
                           Foreground="#101828"
                           TextWrapping="Wrap"
                           Text="Override status pending." />
                <TextBlock x:Name="SettingsPathText"
                           Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Override path pending." />
              </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="How to Tune This App" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="#101828"
                           TextWrapping="Wrap"
                           Text="Create or update appsettings.Development.json next to the deployed appsettings.json file when you want machine-local sampling or retention changes without editing tracked defaults." />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="The dashboard reads these values at startup and shows them here so you can verify what the running desktop app is actually using." />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
