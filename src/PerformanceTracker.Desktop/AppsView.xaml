<UserControl x:Class="PerformanceTracker.Desktop.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#CAD9E6" />

    <Style x:Key="AppExpanderStyle" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="Toggle process details" HorizontalContentAlignment="Stretch"
                            Content="{TemplateBinding Header}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="8" Padding="4,2">
                      <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Width="22" VerticalAlignment="Center"
                                   Foreground="#16778E" FontWeight="SemiBold" Text="&#x25B8;" />
                        <ContentPresenter />
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderSurface" Property="Background" Value="#EEF7FC" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="HeaderSurface" Property="Background" Value="#EEF7FC" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EndButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="86" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Foreground" Value="#0B2F4D" />
      <Setter Property="Background" Value="#E7F3FA" />
      <Setter Property="BorderBrush" Value="#BED7E7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#D0E9F4" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#EEF2F6" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D0D5DD" />
                <Setter Property="Foreground" Value="#667085" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ProcessRowTemplate">
      <Border Padding="12,7" BorderBrush="#DAE7F0" BorderThickness="0,0,0,1" Background="#F5FAFD">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="126" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock FontWeight="SemiBold" Foreground="#0B2F4D" Text="{Binding DisplayName}" />
            <TextBlock FontSize="11" Foreground="#4C6379" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding MemoryText}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CpuText}" Foreground="#4C6379" />
          <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" ToolTip="{Binding StatusReason}" />
          <Button Grid.Column="4" Style="{StaticResource EndButtonStyle}" Content="{Binding EndButtonText}" IsEnabled="{Binding CanEnd}"
                  ToolTip="{Binding EndButtonToolTip}" ToolTipService.ShowOnDisabled="True" Click="OnEndClicked" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AppRowTemplate">
      <Border Margin="0,0,0,7" Padding="12,9" Background="White" BorderBrush="#D5E4EF" BorderThickness="1" CornerRadius="12">
        <Expander Style="{StaticResource AppExpanderStyle}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{Binding DisplayName}" Expanded="OnAppExpanded">
          <Expander.Header>
            <Grid Margin="7,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="108" />
                <ColumnDefinition Width="126" />
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="8" Background="#E7F4FA" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock Text="&#x25A6;" Foreground="#16778E" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" />
                  <Border Background="#E7F4FA" CornerRadius="8">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" TextElement.Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0B2F4D" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11" Foreground="#4C6379" Text="{Binding CountText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Foreground="#0B2F4D" Text="{Binding MemoryText}" />
                <ProgressBar ToolTip="Share of physical memory" Height="5" Margin="0,5,0,0" Maximum="1" Value="{Binding MemoryFraction, Mode=OneWay}"
                             Foreground="#1595A6" Background="#DCEBF3" BorderThickness="0" />
              </StackPanel>
              <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="10"
                      Background="{Binding StatusBackground}" ToolTip="{Binding StatusReason}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" Text="{Binding StatusText}" />
              </Border>
            </Grid>
          </Expander.Header>
          <StackPanel Margin="26,10,0,0">
            <DockPanel LastChildFill="True" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource EndButtonStyle}" Content="End app"
                      IsEnabled="{Binding CanEnd}" ToolTip="{Binding EndButtonToolTip}" ToolTipService.ShowOnDisabled="True" Click="OnEndClicked" />
              <TextBlock VerticalAlignment="Center" Foreground="#4C6379" Text="{Binding Explanation}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Margin="0,0,0,8" Foreground="#4C6379" Text="{Binding BrowserNote}" TextWrapping="Wrap" Visibility="{Binding BrowserNoteVisibility}" />
            <StackPanel Margin="0,0,0,10" Visibility="{Binding BrowserNoteVisibility}">
              <TextBlock Text="Open tabs" FontWeight="SemiBold" Foreground="#0B2F4D" Margin="0,0,0,5" />
              <TextBlock Text="{Binding BrowserTabStatus}" Foreground="#4C6379" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BrowserTabStatus}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding BrowserTabs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12,6" Background="#F5FAFD" BorderBrush="#DAE7F0" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="Close tab"
                                IsEnabled="{Binding CanClose}"
                                ToolTip="{Binding CloseHint}" ToolTipService.ShowOnDisabled="True" Click="OnCloseTabClicked">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EndButtonStyle}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                Padding="6,2" CornerRadius="8" Background="#E7F4FA">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="Current tab" Foreground="#16778E" FontWeight="SemiBold" FontSize="11" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="#16778E" FontWeight="SemiBold" Text="{Binding Detail}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" ToolTip="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" Foreground="#0B2F4D" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Processes}" ItemTemplate="{StaticResource ProcessRowTemplate}" />
          </StackPanel>
        </Expander>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Margin="0,0,0,12"
            Padding="16"
            Background="#0B2F4D"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="White"
                     Text="What's using your memory" />
          <TextBlock x:Name="MemorySummaryText"
                     Margin="0,8,0,0"
                     FontSize="16"
                     Foreground="White"
                     Text="Reading running apps..." />
          <ProgressBar x:Name="MemoryUsageBar"
                       Height="8"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Left"
                       Width="450"
                       Maximum="1"
                       Foreground="#42CED9"
                       Background="#D9E6F2"
                       BorderThickness="0" />
          <TextBlock x:Name="SuggestionSummaryText"
                     Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Foreground="#8BE5C1"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="ActionStatusText"
                     Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Foreground="White"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Column="1" TextElement.Foreground="White" Margin="16,0,0,0" VerticalAlignment="Top">
          <Button x:Name="RefreshButton"
                  Padding="14,6"
                  HorizontalAlignment="Right"
                  Style="{StaticResource EndButtonStyle}"
                  Content="Refresh"
                  Click="OnRefreshClicked" />
          <CheckBox x:Name="HideSmallCheckBox"
                    Margin="0,12,0,0"
                    Foreground="White"
                    IsChecked="True"
                    Content="Hide apps under 50 MB"
                    Checked="OnFilterChanged"
                    Unchecked="OnFilterChanged" />
          <CheckBox x:Name="ShowWindowsCheckBox"
                    Margin="0,6,0,0"
                    Foreground="White"
                    Content="Show Windows system processes"
                    Checked="OnFilterChanged"
                    Unchecked="OnFilterChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <ListBox x:Name="AppList"
             VirtualizingPanel.VirtualizationMode="Recycling"
             Grid.Row="1"
             Background="Transparent"
             BorderThickness="0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.ScrollUnit="Pixel"
             ItemTemplate="{StaticResource AppRowTemplate}">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
  </Grid>
</UserControl>
