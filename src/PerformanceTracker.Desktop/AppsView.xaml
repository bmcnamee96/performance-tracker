<UserControl x:Class="PerformanceTracker.Desktop.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#24384C" />

    <Style x:Key="AppExpanderStyle" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="Toggle process details" HorizontalContentAlignment="Stretch"
                            Content="{TemplateBinding Header}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="8" Padding="4,2">
                      <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Width="22" VerticalAlignment="Center"
                                   Foreground="#5CC8D8" FontWeight="SemiBold" Text="&#x25B8;" />
                        <ContentPresenter />
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderSurface" Property="Background" Value="#1B3045" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="HeaderSurface" Property="Background" Value="#1B3045" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EndButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="86" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Foreground" Value="#E6EEF5" />
      <Setter Property="Background" Value="#1C3349" />
      <Setter Property="BorderBrush" Value="#2E4A63" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#25415B" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#152230" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#24384C" />
                <Setter Property="Foreground" Value="#6B7F94" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProcessActionMenuStyle" TargetType="ContextMenu">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#162636" BorderBrush="#36516A" BorderThickness="1" Padding="3">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProcessActionMenuItemStyle" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#E6EEF5" />
      <Setter Property="MinWidth" Value="165" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemBackground" Background="Transparent" Padding="12,7">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBackground" Property="Background" Value="#25415B" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8EA3B8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ProcessRowTemplate">
      <Border Padding="12,7" BorderBrush="#22364A" BorderThickness="0,0,0,1" Background="#162636">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="105" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="126" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding DisplayName}" />
            <TextBlock FontSize="11" Foreground="#8EA3B8" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#E6EEF5" Text="{Binding MemoryText}" ToolTip="{Binding MemoryTooltip}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CpuText}" Foreground="#8EA3B8" />
          <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" ToolTip="{Binding StatusReason}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal">
            <Button Margin="0,0,5,0" Style="{StaticResource EndButtonStyle}" Content="Resume"
                    Visibility="{Binding ResumeVisibility}" Click="OnResumeClicked" />
            <Button Margin="0,0,5,0" Style="{StaticResource EndButtonStyle}" Content="More actions"
                    IsEnabled="{Binding CanUseActions}" Click="OnMoreActionsClicked" />
            <Button Style="{StaticResource EndButtonStyle}" Content="{Binding EndButtonText}" IsEnabled="{Binding CanEnd}"
                    ToolTip="{Binding EndButtonToolTip}" ToolTipService.ShowOnDisabled="True" Click="OnEndClicked" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedProcessTemplate">
      <StackPanel>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessRowTemplate}" />
        <ItemsControl Margin="18,0,0,0" ItemsSource="{Binding Processes}" ItemTemplate="{StaticResource ProcessRowTemplate}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AppRowTemplate">
      <Border Margin="0,0,0,7" Padding="12,9" Background="#111E2C" BorderBrush="#24384C" BorderThickness="1" CornerRadius="12">
        <Expander Style="{StaticResource AppExpanderStyle}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{Binding DisplayName}" Expanded="OnAppExpanded">
          <Expander.Header>
            <Grid Margin="7,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="108" />
                <ColumnDefinition Width="156" />
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="8" Background="#1A2E42" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock Text="&#x25A6;" Foreground="#5CC8D8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" />
                  <Border Background="#1A2E42" CornerRadius="8">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" TextElement.Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11" Foreground="#8EA3B8" Text="{Binding CountText}" />
                <TextBlock FontSize="11" Foreground="#8EA3B8" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Foreground="#E6EEF5" Text="{Binding MemoryText}" ToolTip="{Binding MemoryTooltip}" />
                <ProgressBar ToolTip="Share of physical memory" Height="5" Margin="0,5,0,0" Maximum="1" Value="{Binding MemoryFraction, Mode=OneWay}"
                             Foreground="#3FD5E6" Background="#22364A" BorderThickness="0" />
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="10"
                        Background="{Binding StatusBackground}" ToolTip="{Binding StatusReason}">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" Text="{Binding StatusText}" />
                </Border>
                <Border Margin="6,0,0,0" Padding="9,4" CornerRadius="10" Background="#44341C"
                        Visibility="{Binding GrowthVisibility}" ToolTip="{Binding Growth.Reason}" VerticalAlignment="Center">
                  <TextBlock Text="Growing" FontSize="11" FontWeight="SemiBold" Foreground="#FFD18A" />
                </Border>
              </StackPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Margin="26,10,0,0">
            <DockPanel LastChildFill="True" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource EndButtonStyle}" Content="End app"
                      IsEnabled="{Binding CanEnd}" ToolTip="{Binding EndButtonToolTip}" ToolTipService.ShowOnDisabled="True" Click="OnEndClicked" />
              <Button DockPanel.Dock="Right" Margin="5,0,0,0" Style="{StaticResource EndButtonStyle}" Content="More actions"
                      IsEnabled="{Binding CanUseActions}" Click="OnMoreActionsClicked" />
              <Button DockPanel.Dock="Right" Margin="5,0,0,0" Style="{StaticResource EndButtonStyle}" Content="Resume"
                      Visibility="{Binding ResumeVisibility}" Click="OnResumeClicked" />
              <TextBlock VerticalAlignment="Center" Foreground="#8EA3B8" Text="{Binding Explanation}" TextWrapping="Wrap" />
            </DockPanel>
            <Border Background="#162636" BorderBrush="#24384C" BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Private memory over the last 3 hours" Foreground="#E6EEF5" FontWeight="SemiBold" />
                <Path Data="{Binding MemoryChart}" Stroke="#3FD5E6" StrokeThickness="2"
                      Height="42" Width="240" HorizontalAlignment="Left" Margin="0,4,0,0">
                  <Path.Style>
                    <Style TargetType="Path">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding MemoryChart}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Path.Style>
                </Path>
                <TextBlock Text="{Binding MemoryTrend}" Foreground="#8EA3B8" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Margin="0,0,0,8" Foreground="#8EA3B8" Text="{Binding BrowserNote}" TextWrapping="Wrap" Visibility="{Binding BrowserNoteVisibility}" />
            <StackPanel Margin="0,0,0,10" Visibility="{Binding BrowserNoteVisibility}">
              <TextBlock Text="Open tabs" FontWeight="SemiBold" Foreground="#E6EEF5" Margin="0,0,0,5" />
              <TextBlock Text="{Binding BrowserTabStatus}" Foreground="#8EA3B8" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BrowserTabStatus}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding BrowserTabs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12,6" Background="#162636" BorderBrush="#22364A" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="Close tab"
                                IsEnabled="{Binding CanClose}"
                                ToolTip="{Binding CloseHint}" ToolTipService.ShowOnDisabled="True" Click="OnCloseTabClicked">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EndButtonStyle}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                Padding="6,2" CornerRadius="8" Background="#1A2E42">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="Current tab" Foreground="#5CC8D8" FontWeight="SemiBold" FontSize="11" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="#5CC8D8" FontWeight="SemiBold" Text="{Binding Detail}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" ToolTip="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" Foreground="#E6EEF5" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Processes}" ItemTemplate="{StaticResource ExpandedProcessTemplate}" />
          </StackPanel>
        </Expander>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Margin="0,0,0,12"
            Padding="16"
            Background="#0F2438"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="White"
                     Text="What's using your memory" />
          <TextBlock x:Name="MemorySummaryText"
                     Margin="0,8,0,0"
                     FontSize="16"
                     Foreground="White"
                     Text="Reading running apps..." />
          <ProgressBar x:Name="MemoryUsageBar"
                       Height="8"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Left"
                       Width="450"
                       Maximum="1"
                       Foreground="#42CED9"
                       Background="#22364A"
                       BorderThickness="0" />
          <TextBlock x:Name="MemoryBreakdownText"
                     Margin="0,6,0,0"
                     Foreground="#8EA3B8"
                     TextWrapping="Wrap"
                     ToolTip="Windows itself is memory held by the system rather than any one app: drivers, the kernel, the file cache and shared code. It isn't something you can close." />
          <TextBlock x:Name="SuggestionSummaryText"
                     Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Foreground="#8BE5C1"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="ActionStatusText"
                     Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Foreground="White"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Column="1" TextElement.Foreground="White" Margin="16,0,0,0" VerticalAlignment="Top">
          <Button x:Name="RefreshButton"
                  Padding="14,6"
                  HorizontalAlignment="Right"
                  Style="{StaticResource EndButtonStyle}"
                  Content="Refresh"
                  Click="OnRefreshClicked" />
          <CheckBox x:Name="HideSmallCheckBox"
                    Margin="0,12,0,0"
                    Foreground="White"
                    IsChecked="True"
                    Content="Hide apps under 30 MB of private memory"
                    Checked="OnFilterChanged"
                    Unchecked="OnFilterChanged" />
          <CheckBox x:Name="ShowWindowsCheckBox"
                    Margin="0,6,0,0"
                    Foreground="White"
                    Content="Show Windows system processes"
                    Checked="OnFilterChanged"
                    Unchecked="OnFilterChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <ListBox x:Name="AppList"
             VirtualizingPanel.VirtualizationMode="Recycling"
             Grid.Row="1"
             Background="Transparent"
             BorderThickness="0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.ScrollUnit="Pixel"
             ItemTemplate="{StaticResource AppRowTemplate}">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
  </Grid>
</UserControl>
